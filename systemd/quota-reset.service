[Unit]
Description=printquota rolling quota period reset
Documentation=man:systemd.timer(5)

[Service]
Type=oneshot
User=printquota
Group=printquota
EnvironmentFile=/etc/printquota/env
ExecStart=/opt/printquota/bin/printquota-reset
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/printquota
ReadOnlyPaths=/etc/printquota
