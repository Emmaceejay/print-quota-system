# Runtime overrides. Anything here beats config/settings.yaml.
PRINTQUOTA_CONFIG=/etc/printquota/settings.yaml
PRINTQUOTA_DB_URL=sqlite:////var/lib/printquota/printquota.db
PRINTQUOTA_SECRET_KEY=change-me-to-a-long-random-string
PRINTQUOTA_LOG_LEVEL=INFO
# SMTP (leave host empty to disable email alerts)
PRINTQUOTA_SMTP_HOST=
PRINTQUOTA_SMTP_PORT=25
PRINTQUOTA_SMTP_USER=
PRINTQUOTA_SMTP_PASSWORD=
PRINTQUOTA_SMTP_FROM=printquota@localhost
